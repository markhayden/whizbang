{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just check)",
      "Bash(just scan)",
      "Bash(just scan-secrets)",
      "Bash(just docs)",
      "Bash(just docs-check)",
      "Bash(just test)",
      "Bash(just test-only *)",
      "Bash(just test-scripts)",
      "Bash(just test-scripts-slow)",
      "Bash(just test-timeout)",
      "Bash(just search-canary)",
      "Bash(just timing)",
      "Bash(just fmt-check)",
      "Bash(just clippy)",
      "Bash(just graph)",
      "Bash(just deny)",
      "Bash(just deny-advisories)",
      "Bash(just smoke)",
      "Bash(just setup)",
      "Bash(just ci)",
      "Bash(just --list)",
      "Bash(just scan-range *)",
      "Bash(just scan-range-secrets *)",
      "Bash(scripts/scan.sh)",
      "Bash(scripts/scan.sh --secrets-only)",
      "Bash(scripts/setup.sh --check)",
      "Bash(scripts/docs.sh --check)",
      "Bash(scripts/tests/run.sh)",
      "Bash(scripts/check-crate-graph.sh)",
      "Bash(scripts/timing.sh)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --list)",
      "Bash(git branch --list -a)",
      "Bash(git branch --list -r)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin main)",
      "Bash(git ls-remote origin)",
      "Bash(git ls-remote --heads origin)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "ask": [
      "Bash(*git push*)",
      "Bash(*git merge*)",
      "Bash(*git tag*)",
      "Bash(*gh pr merge*)",
      "Bash(*gh release*)",
      "Bash(*cargo publish*)",
      "Bash(gh * -R*)",
      "Bash(gh * --repo*)",
      "Bash(gh *://*)",
      "Bash(gh *github.com*)"
    ],
    "deny": [
      "Bash(*--no-verify*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
