{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A whizbang run record, version run/2 (ADR 0005)",
  "type": "object",
  "additionalProperties": false,
  "required": ["record", "identity", "asked", "inputs", "outputs", "outcome", "time", "models", "spend", "egress", "steps", "judge", "diagnostics"],
  "properties": {
    "record": { "const": "run/2" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "request", "parent", "whizbang"],
      "properties": {
        "run": { "type": "string", "minLength": 1 },
        "request": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "parent": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
        "whizbang": { "type": "string", "minLength": 1 }
      }
    },
    "asked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "version", "arguments", "settings", "config"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "maxProperties": 1,
                "properties": {
                  "number": { "type": "number" },
                  "integer": { "type": "integer" },
                  "boolean": { "type": "boolean" },
                  "text": { "type": "string" }
                }
              }
            }
          }
        },
        "settings": { "type": "array", "maxItems": 0 },
        "config": { "$ref": "#/$defs/digest" }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["port", "type", "artifact", "binding"],
        "properties": {
          "port": { "type": "string", "minLength": 1 },
          "type": { "$ref": "#/$defs/artifact_type" },
          "artifact": { "$ref": "#/$defs/digest" },
          "binding": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["port", "type", "artifact"],
        "properties": {
          "port": { "type": "string", "minLength": 1 },
          "type": { "$ref": "#/$defs/artifact_type" },
          "artifact": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error", "invalid", "refusals", "refusals_omitted"],
      "properties": {
        "status": { "enum": ["completed", "cancelled", "error", "invalid"] },
        "error": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["kind", "message"],
          "properties": {
            "kind": { "type": "string" },
            "message": { "type": "string" }
          }
        },
        "invalid": { "type": ["string", "null"] },
        "refusals": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "kind", "why"],
            "properties": {
              "action": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
              "kind": { "enum": ["unknown_action", "invalid", "input", "not_ready", "read_only", "no_such_run", "conflict", "stale", "over_allowance", "no_bound", "secret_in_request_id", "not_a_request_id", "cancelled", "deadline_passed", "too_deep", "call_back", "over_caller", "too_many_calls", "tree_full", "too_many_started", "too_many_started_under", "id_inside"] },
              "why": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        },
        "refusals_omitted": { "type": "integer", "minimum": 0 }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "durations"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "durations": { "type": "array", "maxItems": 0 }
      }
    },
    "models": { "type": "array", "maxItems": 0 },
    "spend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reserved_micros", "requests"],
      "properties": {
        "reserved_micros": { "type": ["integer", "null"], "minimum": 0 },
        "requests": { "type": "array", "maxItems": 0 }
      }
    },
    "egress": { "type": "array", "maxItems": 0 },
    "steps": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "run", "action", "status"],
        "properties": {
          "step": { "enum": ["call"] },
          "run": { "type": "string", "minLength": 1, "maxLength": 64 },
          "action": { "type": "string", "minLength": 1, "maxLength": 64 },
          "status": { "enum": ["completed", "cancelled", "error", "invalid", null] }
        }
      }
    },
    "judge": { "type": "array", "maxItems": 0 },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest", "bytes"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "minLength": 71, "maxLength": 71 },
    "artifact_type": { "enum": ["mask", "location", "image", "band_profile", "series", "plan"] }
  }
}
