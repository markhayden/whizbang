{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "findings/1: what an action hands back as findings (ADR 0035): each answer of a judge's that counts against a pass, as data. No field holds a text of a judge's. Beside this schema: a document is at most 32768 bytes as JSON; its findings cite at most 8 places together; an obligation's id is one to eight upper-case letters and then one to four digits, and a finding cites each once; an item cites one obligation; confidence is null for observed and for nothing else; an image is sha256: and 64 lower-case hex digits; a place is one box or one polygon, a box's left before its right and its top before its bottom; complete is true exactly when left_out counts nothing",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "decision", "complete", "left_out", "items"],
  "properties": {
    "findings": { "const": "findings/1" },
    "decision": { "enum": ["pass", "fail", "unsure"] },
    "complete": { "type": "boolean" },
    "left_out": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "places"],
      "properties": {
        "findings": { "type": "integer", "minimum": 0 },
        "places": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "obligations", "disposition", "confidence", "place"],
      "properties": {
        "form": { "enum": ["item", "observation"] },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 2, "maxLength": 12 }
        },
        "disposition": {
          "enum": ["violation", "held", "allowed_change", "hidden", "cant_tell", "observed"]
        },
        "confidence": { "enum": ["confident", "tentative", null] },
        "place": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/place" }] }
      }
    },
    "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "oneOf": [{ "required": ["box"] }, { "required": ["polygon"] }],
      "properties": {
        "image": { "type": "string", "minLength": 71, "maxLength": 71 },
        "box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/fraction" }
        },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "$ref": "#/$defs/fraction" }
          }
        }
      }
    }
  }
}
